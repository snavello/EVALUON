# Los scripts y el Dockerfile corren dentro de contenedores Linux: siempre con fin de
# línea LF, aunque el equipo use core.autocrlf=true.
*.sh text eol=lf
Dockerfile text eol=lf

# El corpus se guarda byte por byte: su huella tiene que coincidir con corpus/manifiesto.csv
# en cualquier equipo, sin conversión de fin de línea.
corpus/** -text

# Los archivos de prueba se guardan byte por byte: algunos son copias exactas de
# documentos del corpus y tienen que seguir siéndolo en cualquier equipo.
tests/fixtures/** -text
