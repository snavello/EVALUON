# Variables del entorno de EVALUON. Copiar a .env y ajustar; .env no se sube al repositorio.
# Sin .env, docker-compose.yml usa los valores por defecto que figuran aquí.

# Servicio generation (llama-server). Los parámetros propios del modelo viven en la
# configuración, no en el código (ADR-0002).
GENERATION_MODEL_FILE=gemma-4-12b-it-qat-q4_0.gguf
GENERATION_MODEL_ALIAS=gemma-4-12b-it-qat-q4_0
GENERATION_CTX_SIZE=16384

# scripts/fetch_models.sh (opcionales)
# MODELS_DIR=
# CURL_EXTRA_OPTS=--ssl-no-revoke
