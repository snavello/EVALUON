# Variables del entorno de EVALUON. Copiar a .env y ajustar; .env no se sube al repositorio.
# POSTGRES_PASSWORD no tiene valor por defecto: sin ella docker compose no arranca.
# DJANGO_SECRET_KEY tampoco: sin ella la aplicación (app, migrate y las pruebas) no arranca.
# Las demás, si faltan, toman los valores por defecto que figuran aquí.

# Servicio db (Postgres 17 con pgvector). La base no publica puertos: solo la alcanzan
# los servicios de la red interna. Poner una clave propia de cada equipo, larga y al azar
# (por ejemplo, la salida de: py -3 -c "import secrets; print(secrets.token_urlsafe(32))").
POSTGRES_DB=evaluon
POSTGRES_USER=evaluon
POSTGRES_PASSWORD=

# Servicio generation (llama-server). Los parámetros propios del modelo viven en la
# configuración, no en el código (ADR-0002).
GENERATION_MODEL_FILE=gemma-4-12b-it-qat-q4_0.gguf
GENERATION_MODEL_ALIAS=gemma-4-12b-it-qat-q4_0
GENERATION_CTX_SIZE=16384
# Contexto (tokens) del motor de lotes, `generation_batch` (plan 004, ADR-0037): lo usan el
# `worker` y los comandos de medición para leer ofertas completas. Mayor que el de
# `generation`; sube la memoria de video (ver specs/004-evaluacion-asistida/entorno.md).
GENERATION_BATCH_CTX_SIZE=32768
# Modelo propio del motor de lotes (plan 004, ADR-0041 y ADR-0042); si faltan, valen los de
# `generation`. El proyector de imagen es el de la lectura con visión. Para las
# comparaciones de modelos no se cambian aquí: se usa un archivo adicional, que trae estas
# variables con la huella de cada archivo: docker-compose.modelo-grande.yml (26B-A4B, 004),
# docker-compose.qwen38-27b.yml (Qwen3.8-27B) o docker-compose.qwen36-35b.yml
# (Qwen3.6-35B-A3B) de la 015 (ADR-0056); los archivos se bajan con scripts/fetch_models.sh
# --modelo-grande, --qwen38-27b o --qwen36-35b y cómo se usan y se vuelve al 12B está en
# specs/015-uso-y-eleccion-del-modelo/entorno.md. Con esas
# variables se registra el modelo de cada evaluación, propuesta y ficha (P6); al cambiar un
# archivo, cambiar también su huella (scripts/models.sha256).
# GENERATION_BATCH_MODEL_ALIAS=gemma-4-12b-it-qat-q4_0
# GENERATION_BATCH_MODEL_FILE=gemma-4-12b-it-qat-q4_0.gguf
# GENERATION_BATCH_MODEL_SHA256=93567e57a8fe10b23569b9d9ec38cd005deedf71e29477c421a4b83f418a538b
# GENERATION_BATCH_MMPROJ_FILE=mmproj-gemma-4-12b-it-qat-q4_0.gguf
# GENERATION_BATCH_MMPROJ_SHA256=cb018338a7538a9814d994bfe54644c71eb7ed54e31eae2f721e45fd3c260da7
# Tope (MiB) del caché de pedidos en la memoria del equipo, por servidor de generación
# (T-090). Sin tope son 8192 por servidor y la memoria de WSL2 no alcanza para los dos.
GENERATION_CACHE_RAM=2048

# Uso por omisión (T-247 y T-255, ADR-0057): el responsable adoptó el Qwen3.8-27B (2026-10-12, «Sí;
# Consulta con el 27B»). `docker compose up -d` levanta el 27B en `generation_batch`, con el
# razonamiento propio del modelo SOLO en el contraste, y sin `generation`: la Consulta de normativa
# usa ese mismo motor, sin razonamiento. El motor atiende de a un pedido: mientras corre una
# evaluación, una matriz o una ficha, la Consulta lo dice y espera (la búsqueda directa sigue).
#   - docker-compose.qwen38-27b.yml: el 27B en `generation_batch` (se baja con
#     `bash scripts/fetch_models.sh --qwen38-27b`).
#   - docker-compose.razonamiento.yml: permite pensar al servidor; el paso lo elige la variable de abajo.
#   - docker-compose.consulta-27b.yml: `generation` no arranca y la Consulta va a `generation_batch`.
# Otras combinaciones: el 27B SIN Consulta (la pantalla dice que no está disponible) cambia el último
# archivo por docker-compose.sin-consulta.yml; el 12B con la Consulta aparte, como la 001 a la 014,
# borra o comenta estas dos líneas (COMPOSE_FILE y COMPOSE_PATH_SEPARATOR) y las de razonamiento, y
# recrea (specs/015-uso-y-eleccion-del-modelo/entorno.md, «Cómo se vuelve al 12B»).
# COMPOSE_PATH_SEPARATOR fija `:` en cualquier sistema (en Windows el de Compose es `;`). Los
# comandos con `-f archivo` explícito (mediciones, runbooks anteriores) no leen COMPOSE_FILE.
COMPOSE_FILE=docker-compose.yml:docker-compose.qwen38-27b.yml:docker-compose.razonamiento.yml:docker-compose.consulta-27b.yml
COMPOSE_PATH_SEPARATOR=:
# Pasos del motor de lotes que piensan, con su nivel (low, medium o high; vacío u off, no piensa):
# extraction, completeness, filter, evaluation y contrast. Por omisión solo el contraste, en low
# (tope de 1.024 tokens de razonamiento por pedido; T-244d). Los demás pasos no se encienden sin medir:
# T-244b y T-244c mostraron que empeoran la matriz o la evaluación del 27B.
GENERATION_BATCH_REASONING_CONTRAST=low
# GENERATION_BATCH_REASONING_EXTRACTION=
# GENERATION_BATCH_REASONING_COMPLETENESS=
# GENERATION_BATCH_REASONING_FILTER=
# GENERATION_BATCH_REASONING_EVALUATION=

# Servicios embeddings y reranker (llama-server, ADR-0003). El contexto se usa también
# como tamaño de lote: cada texto (o par pregunta y pasaje) entra entero o se rechaza.
EMBEDDINGS_MODEL_FILE=bge-m3-FP16.gguf
EMBEDDINGS_MODEL_ALIAS=bge-m3
EMBEDDINGS_CTX_SIZE=8192
RERANKER_MODEL_FILE=bge-reranker-v2-m3-FP16.gguf
RERANKER_MODEL_ALIAS=bge-reranker-v2-m3
RERANKER_CTX_SIZE=8192

# Clientes de IA de la aplicación (evaluon/ai/, T-011). Direcciones de los tres servicios
# en la red interna y huellas SHA-256 de los archivos de los modelos, que se registran
# con cada consulta; tienen que coincidir con scripts/models.sha256. El nombre de cada
# modelo es el alias de arriba. docker-compose.yml pasa estas variables y las de modelo
# de arriba (alias, archivo y contexto de generación) a `app` y `migrate`, con los mismos
# valores por defecto que usan los servicios (T-054): un cambio de modelo en este archivo
# llega igual al servidor y a la aplicación. Al cambiar un archivo de modelo, poner
# también su huella. Si faltan, toman los valores por defecto que figuran aquí.
# GENERATION_URL=http://generation:8080
# Motor de los pedidos en segundo plano (servicio worker y comando de medición de la
# matriz; ADR-0018). Por defecto, la segunda instancia generation_batch. Con
# http://generation:8080 se vuelve a un solo motor sin cambiar código: la consulta de
# normativa espera entonces a que termine el pedido en curso de la matriz.
# GENERATION_BATCH_URL=http://generation_batch:8080
# EMBEDDINGS_URL=http://embeddings:8080
# RERANKER_URL=http://reranker:8080
# GENERATION_MODEL_SHA256=93567e57a8fe10b23569b9d9ec38cd005deedf71e29477c421a4b83f418a538b
# EMBEDDINGS_MODEL_SHA256=daec91ffb5dd0c27411bd71f29932917c49cf529a641d0168496c3a501e3062c
# RERANKER_MODEL_SHA256=5df93be121c09c43432102ad2b9569d369ccb85c209ca7583e8ccd28f0e41b88

# scripts/fetch_models.sh (opcionales)
# MODELS_DIR=
# CURL_EXTRA_OPTS=--ssl-no-revoke

# Servicios app y migrate (Django, imagen propia del Dockerfile).
# Clave secreta de Django: propia de cada equipo, larga y al azar (por ejemplo, la salida
# de: py -3 -c "import secrets; print(secrets.token_urlsafe(50))"). Nunca se sube.
DJANGO_SECRET_KEY=
# Modo de depuración: siempre false salvo para diagnosticar en el propio equipo.
DJANGO_DEBUG=false
# Nombres con los que se llega a la aplicación, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Puerto de la aplicación en el equipo; se publica solo en 127.0.0.1.
APP_PORT=8000
# La aplicación llega a la base por la red interna (db:5432); docker-compose.yml fija
# POSTGRES_HOST y POSTGRES_PORT para app y migrate. Solo hace falta definirlas para
# correr Django fuera de Docker.
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# Carpeta donde collectstatic reúne los archivos estáticos (por defecto, staticfiles/).
# DJANGO_STATIC_ROOT=

# Acceso por red (plan 007). Las computadoras de la Comisión entran por
# https://EVALUON_ADDRESS a través de Caddy, que corre en este mismo equipo y corta toda
# computadora que no esté en la lista. Lo aplica scripts\red\aplicar-red.ps1 (PowerShell
# como administrador); los pasos están en specs/007-acceso-por-red/entorno.md. Para agregar
# o quitar una computadora: editar la lista y volver a correr ese script. Sin estas
# variables EVALUON se usa solo en este equipo, como siempre. Las direcciones de abajo son
# de ejemplo (de documentación): poner las de la red del organismo.
# La dirección se suma también a DJANGO_ALLOWED_HOSTS (más arriba), por ejemplo:
#   DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.0.2.10
# Dirección con que se entra: un nombre del DNS interno o la IPv4 fija de este equipo.
# EVALUON_ADDRESS=192.0.2.10
# IPv4 fija de este equipo en la red del organismo.
# EVALUON_SERVER_IP=192.0.2.10
# Computadoras autorizadas: nombre=IPv4, separadas por comas; 10 como máximo, sin
# repetidos. El nombre (letras sin acentos, números y guiones) es el que queda en el
# registro de accesos. Este equipo no va en la lista: entra siempre, como
# equipo-del-sistema.
# EVALUON_COMPUTERS=comision-1=192.0.2.21,comision-2=192.0.2.22

# Importación desde el Portal de Compras (plan 012, ADR-0031). Solo el servicio
# portal_worker tiene salida a internet y solo conecta a estos hosts, por HTTPS (puerto 443).
# Lista separada por comas; por omisión, el host del Portal.
# PORTAL_ALLOWED_HOSTS=afipcompras.afip.gob.ar
# Espera máxima de cada solicitud (segundos), tamaño máximo de cada respuesta (bytes) y
# pausa entre solicitudes (segundos).
# PORTAL_TIMEOUT_SECONDS=30
# PORTAL_MAX_BYTES=52428800
# PORTAL_PAUSE_SECONDS=2
# Hora local desde la que se encola la revisión diaria de los procesos seguidos.
# PORTAL_REVIEW_HOUR=7
# Identificación que el cliente declara en cada solicitud al Portal.
# PORTAL_USER_AGENT=EVALUON/1.0 (lectura de procesos publicos)

# Instancia clonada de la feature 016 (specs/016-calidad-medible/entorno.md; scripts/clon.sh).
# No es de la instalación de uso: es un segundo entorno con su propia base, en 127.0.0.1:8016, para
# medir sin tocar la instancia de trabajo (8000). Todo va en un archivo FUERA del repositorio
# (clon.env, en la carpeta local del Coordinador: COORD_DIR), que scripts/clon.sh genera con claves
# al azar la primera vez; estas líneas solo dicen qué variables lee. Se dejan comentadas y sin
# valores reales: ningún secreto ni ruta de un equipo va al repositorio (P4).
# Código que monta el clon: la copia de trabajo de la rama 016-integracion o una copia fija
# (`git archive`) del commit que se mide. Ejemplo de ruta de un equipo: C:/ruta/a/la/copia
# CLON_CODE_DIR=
# Carpeta models/ con los archivos .gguf; por omisión, la del repositorio raíz.
# CLON_MODELS_DIR=
# Casos del clon (corpus/casos del clon, con escritura); por omisión, una carpeta junto a clon.env.
# CLON_CASOS_DIR=
# Puerto del clon, solo en 127.0.0.1.
# CLON_PORT=8016
# Razonamiento del clon: por omisión solo el contraste en `low`, como en 8000; para una variante de
# medición se cambia en clon.env (los nombres son los de docker-compose.razonamiento.yml).
# GENERATION_BATCH_REASONING_CONTRAST=low
# Ventana de GPU: memoria de video usada tolerada (MiB) con el motor de 8000 detenido, y espera
# máxima (segundos) de la carga de un motor.
# CLON_GPU_MAX_MIB=6000
# CLON_ESPERA_MOTOR=1500

# Uso externo de la feature 016 (plan 016; ADR-0066 y ADR-0068; constitución 1.6). Apagado por
# omisión: con estos valores el sistema funciona como hoy y nada sale a internet. Solo se enciende
# en el clon (scripts/clon.sh + docker-compose.externo.yml), con material público (P4).
# La clave del proveedor (ANTHROPIC_API_KEY) NO se escribe acá ni en ningún archivo del repositorio:
# va en el archivo de entorno del clon, fuera del repositorio. Los valores son los por omisión.
# EXTERNAL_ENABLED=false
# Por etapa: local o externo.
# EXTERNAL_STAGE_MATRIZ=local
# EXTERNAL_STAGE_VERIFICADOR=local
# EXTERNAL_MODEL_MATRIZ=claude-sonnet-5-5
# EXTERNAL_MODEL_VERIFICADOR=claude-sonnet-5-5
# Esfuerzo (low, medium, high) y pensamiento (off, adaptive, between_tools) fijados por etapa.
# EXTERNAL_EFFORT_MATRIZ=medium
# EXTERNAL_EFFORT_VERIFICADOR=low
# EXTERNAL_THINKING_MATRIZ=adaptive
# EXTERNAL_THINKING_VERIFICADOR=between_tools
# lotes (mitad de precio) o directo (solo la prueba de humo).
# EXTERNAL_MODE=lotes
# EXTERNAL_BATCH_POLL_SECONDS=30
# EXTERNAL_BATCH_MAX_WAIT_SECONDS=7200
# Topes de gasto en USD: por caso completo y por mes calendario.
# EXTERNAL_CASE_CAP_USD=2.00
# EXTERNAL_MONTH_CAP_USD=10.00
# Estimado por etapa (USD) y factor desde el cual se frena la etapa (2 = el doble).
# EXTERNAL_STAGE_ESTIMATE_MATRIZ_USD=0.30
# EXTERNAL_STAGE_ESTIMATE_VERIFICADOR_USD=0.30
# EXTERNAL_STAGE_STOP_FACTOR=2
