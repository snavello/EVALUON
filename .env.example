# Variables del entorno de EVALUON. Copiar a .env y ajustar; .env no se sube al repositorio.
# POSTGRES_PASSWORD no tiene valor por defecto: sin ella docker compose no arranca.
# Las demás, si faltan, toman los valores por defecto que figuran aquí.

# Servicio db (Postgres 17 con pgvector). La base no publica puertos: solo la alcanzan
# los servicios de la red interna. Poner una clave propia de cada equipo, larga y al azar
# (por ejemplo, la salida de: py -3 -c "import secrets; print(secrets.token_urlsafe(32))").
POSTGRES_DB=evaluon
POSTGRES_USER=evaluon
POSTGRES_PASSWORD=

# Servicio generation (llama-server). Los parámetros propios del modelo viven en la
# configuración, no en el código (ADR-0002).
GENERATION_MODEL_FILE=gemma-4-12b-it-qat-q4_0.gguf
GENERATION_MODEL_ALIAS=gemma-4-12b-it-qat-q4_0
GENERATION_CTX_SIZE=16384

# Servicios embeddings y reranker (llama-server, ADR-0003). El contexto se usa también
# como tamaño de lote: cada texto (o par pregunta y pasaje) entra entero o se rechaza.
EMBEDDINGS_MODEL_FILE=bge-m3-FP16.gguf
EMBEDDINGS_MODEL_ALIAS=bge-m3
EMBEDDINGS_CTX_SIZE=8192
RERANKER_MODEL_FILE=bge-reranker-v2-m3-FP16.gguf
RERANKER_MODEL_ALIAS=bge-reranker-v2-m3
RERANKER_CTX_SIZE=8192

# scripts/fetch_models.sh (opcionales)
# MODELS_DIR=
# CURL_EXTRA_OPTS=--ssl-no-revoke
